{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-electron",
    "rootDir": ".",
    "module": "CommonJS",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "jsx": "preserve",
    "types": ["node", "electron"]
  },
  "include": [
    "electron-main.ts",
    "electron-preload.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-server",
    "dist-electron",
    "src"
  ]
}