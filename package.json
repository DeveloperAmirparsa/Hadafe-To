{
  "name": "hadafe-to",
  "productName": "هدف تو",
  "description": "اپلیکیشن مدیریت برنامه مطالعه و آمادگی کنکور",
  "author": "Hadafe To Team",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/electron-main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server.js",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "db:push": "node scripts/migrate-json-to-postgres.mjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && tsc -p tsconfig.electron.json && electron-builder",
    "electron:pack": "npm run build && tsc -p tsconfig.electron.json && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "build": {
    "appId": "com.hadafe-to.app",
    "productName": "هدف تو",
    "copyright": "Copyright © 2025 Hadafe To",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "dist-electron/electron-main.js",
      "dist-electron/electron-preload.js",
      "dist-electron/package.json",
      "package.json",
      ".env"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "هدف تو",
      "uninstallDisplayName": "هدف تو",
      "license": "assets/license.txt",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "assets/installer.nsh"
    },
    "portable": {
      "artifactName": "Hadafe-To-${version}-portable.${ext}"
    },
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true
  }
}
